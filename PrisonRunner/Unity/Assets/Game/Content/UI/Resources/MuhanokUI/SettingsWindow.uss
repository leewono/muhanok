/*
   Muhanok settings window — placeholder look.
   UI/UX: replace colours with your art. Typical changes:
     .settings-panel   { background-image: url("project://database/Assets/.../panel.png"); -unity-slice-left: 24; ... }
     .settings-tab     { background-image: ...; }
     .settings-button--primary { background-image: ...; }
   Fonts: set -unity-font-definition on .settings-root (code falls back to Malgun Gothic for Korean).
*/

.settings-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 6, 10, 0.72);
}

.settings-panel {
    width: 1100px;
    height: 700px;
    padding: 28px 36px;
    background-color: rgb(16, 21, 31);
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(255, 170, 60);
}

.settings-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.settings-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 199, 82);
}

.settings-tab-bar {
    flex-direction: row;
    margin-bottom: 16px;
}

.settings-tab {
    width: 160px;
    height: 52px;
    margin-right: 10px;
    font-size: 22px;
    color: rgb(225, 230, 240);
    background-color: rgb(32, 41, 56);
    border-radius: 10px;
    border-width: 0;
}

.settings-tab--selected {
    color: rgb(40, 20, 4);
    background-color: rgb(255, 150, 30);
    -unity-font-style: bold;
}

.settings-content {
    flex-grow: 1;
}

.settings-page {
    padding: 6px 4px;
}

.settings-row {
    height: 56px;
    margin-bottom: 8px;
    font-size: 22px;
    color: rgb(232, 236, 244);
}

.settings-row > Label {
    min-width: 320px;
    color: rgb(232, 236, 244);
}

.settings-preview-row {
    flex-direction: row;
    margin-top: 10px;
}

.settings-preview {
    width: 400px;
    height: 300px;
    background-color: rgb(6, 8, 12);
    border-radius: 10px;
}

.settings-preview-side {
    margin-left: 24px;
    justify-content: center;
}

.settings-status {
    font-size: 22px;
    color: rgb(140, 255, 160);
    margin-bottom: 16px;
    white-space: normal;
    max-width: 480px;
}

.settings-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.settings-button {
    min-width: 180px;
    height: 54px;
    margin-left: 12px;
    font-size: 22px;
    color: rgb(235, 240, 250);
    background-color: rgb(30, 90, 150);
    border-radius: 10px;
    border-width: 0;
}

.settings-button:hover {
    background-color: rgb(45, 115, 185);
}

.settings-button--primary {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgb(255, 122, 5);
}

.settings-button--primary:hover {
    background-color: rgb(255, 152, 30);
}

.settings-button--close {
    min-width: 120px;
}
